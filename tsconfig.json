{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",

    // مضبوطة في `web/tsconfig.json` منذ البداية وكانت غائبة هنا، فبقيت
    // استيراداتٌ معلَّقة بعد حذف مسارها ولم يقُل الفاحصُ شيئاً.
    "noUnusedLocals": true,
    "noUnusedParameters": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "web"]
}
