# انسخ هذا الملف إلى .dev.vars للتطوير المحلي (لا يُرفع إلى Git).
# وفي الإنتاج تُضبط القيم عبر كلاودفلير: wrangler secret put <NAME>
#
# ═══ وهذا الملف هو قائمة الأسرار الوحيدة في المستودع ═══
#
# كلُّ سرٍّ تقرؤه المنصة مذكورٌ هنا، ولا يُعاد سردُه في README ولا في
# wrangler.toml — كانت ثلاث قوائم فافترقت، وبقي سرّان يقرؤهما الكود ولا
# يذكرهما ملفّ المثال. ومن أعدّ بيئته منه وحده لم يعرف بوجودهما.
#
# ويحرسها `test/envContract.test.ts`: سرٌّ يُضاف في `src/types.ts` ولا يُذكر
# هنا يُسقط `npm test`، وسطرٌ هنا لا مقابل له هناك كذلك. فلا تُكتشف الفجوة
# بعد النشر.
#
# وكلها اختيارية إلا `AUTH_CLIENT_SECRET`: غيابُه يمنع الدخول أصلاً، وغيابُ
# ما عداه يعطّل ميزته وحدها ولا يُسقط المنصة.

# ═══ الدخول الموحّد (naf-id) ═══

# سرّ المنصة لدى المركز — به تُبادَل رموز العبور بالجلسات. وبدونه تفشل كل
# محاولة دخول عند المبادلة، ونوعه في كلاودفلير Secret لا Text.
# ومعرّفُ المنصة وعنوانُ المركز ليسا سرّين: في wrangler.toml ← [vars].
AUTH_CLIENT_SECRET=""

# سرّ توقيع الجلسات (نصّ عشوائي طويل)
AUTH_SECRET="change-me-to-a-long-random-string"

# ═══ توليد المحتوى والإشعارات ═══

# Claude — توليد النص. يُقرأ من الخادم فقط ولا يصل المتصفح.
CLAUDE_API_KEY="sk-ant-xxxxxxxx"

# توليد الصور — مزوّد OpenAI (Images API) إن اخترته من الإعدادات
IMAGE_PROVIDER_API_KEY=""

# توليد الفيديو — مزوّد Runway ML إن اخترته من الإعدادات
VIDEO_PROVIDER_API_KEY=""

# إشعارات بريدية — مزوّد Resend إن اخترته من الإعدادات
EMAIL_PROVIDER_API_KEY=""

# ═══ مزوّد النشر ═══

# المزوّد المفعَّل يُختار من: الإعدادات ← المنصات والمزوّد، وهذه القيمة
# احتياطُه قبل أول اختيار. والمدعوم أربعةٌ لا غير:
#
#   mock | buffer | socialapi | ayrshare
#
# وما عداها يردّ «مزوّد غير مدعوم» عند أول نشر — لا يسقط صامتاً إلى
# التجريبي كي لا يظنّ أحدٌ أنه ينشر فعلاً.
PROVIDER_NAME="mock"

# ومفتاحه يُحلّ على مرحلتين: السرّ الخاص بالمزوّد أوّلاً، فإن غاب فالعام
# أدناه. فمن يبدّل بين مزوّدَين يخزّن مفتاحيهما معاً بلا أن يمحو أحدهما
# الآخر عند التبديل.
BUFFER_API_KEY=""
# ومفتاح SocialAPI.ai هذا هو مفتاح مصدر المؤشرات «مزوّد النشر» نفسه —
# منه يُقرأ عددُ المتابعين وملخّص المراجعات، فلا سرَّ ثانياً له.
SOCIALAPI_API_KEY=""
AYRSHARE_API_KEY=""
PROVIDER_API_KEY=""

# ═══ بيسكامب (مركز المعرفة) ═══

# أنشئ تطبيق OAuth في بيسكامب: https://launchpad.37signals.com/integrations
# ثم افتح /api/basecamp/oauth/start للحصول على رمز التجديد.
# ومعرّفا الحساب والمشروع ليسا سرّين: الإعدادات ← التكاملات.
BASECAMP_CLIENT_ID=""
BASECAMP_CLIENT_SECRET=""
BASECAMP_REFRESH_TOKEN=""

# ═══ مصادر المؤشرات ═══
#
# مصدرٌ بلا مفتاح يبقى «غير مربوط» في الإعدادات ← التكاملات، ولا يُسحب منه
# شيء، ولا تسقط المنصة لغيابه. والتفصيل — من أين يأتي كل رقم وأيُّ صلاحيةٍ
# تُمنح على أيّ حساب — في docs/naf-metrics.md.
#
# ومزوّد النشر مصدرٌ من هذه المصادر بمفتاحه أعلاه، فلا سطر له هنا.

# منصة إدارة المكتب (naf-manger) — مفتاح خدمة للقراءة.
# ولها وضعٌ يعمل بلا مفتاح: رفع ملفّ /api/export من شاشة التكاملات.
CRM_API_KEY=""

# حساب خدمة جوجل — ملفّ JSON كاملاً في سرٍّ واحد.
# تقرأ منه ثلاثة مصادر: تحليلات الموقع، وأدوات مشرفي المواقع، والملف
# التجاري. وتفريقُه ثلاثةَ أسرارٍ يعني ثلاث نسخٍ من المفتاح نفسه تنتهي
# صلاحيتها في ثلاثة أوقات.
GOOGLE_SERVICE_ACCOUNT_JSON=""

# مفتاح واجهة جوجل العام — لتقرير تجربة كروم وحده (مؤشرات تجربة الصفحة).
# وهو غير الحساب الخدمي أعلاه: التقرير بياناتٌ عامة لا تُملك، فلا صلاحية
# تُمنح عليه ولا بريدَ يُضاف قارئاً — يُنشأ من Google Cloud Console وتُفعَّل
# عليه واجهة Chrome UX Report ولا شيء غيرها. وبلا هذا المفتاح، أو بلا
# «عنوان الموقع لمؤشرات تجربة الصفحة» في التكاملات، تبقى الثلاثة بلا قيمة
# ويُسحب ما عداها من تحليلات الموقع.
GOOGLE_API_KEY=""

# المصادر الأربعة التي تُنادى بالعقد الواحد (العقد في docs/naf-metrics.md)
ADS_API_KEY=""
MESSAGING_API_KEY=""
CALL_TRACKING_API_KEY=""
LISTENING_API_KEY=""

# ═══ الموقع الرئيسي (naf-home) ═══

# رمزٌ واحد للاتجاهين: تحمله نقاط /api/site هنا (اشتراك النشرة وإلغاؤه
# وقائمة الأعداد)، ويحمله الموقع في NEWSLETTER_API_TOKEN عنده. وهو نفسه
# رمزُ مصدر «الموقع الرئيسي» في التكاملات — سرٌّ واحد لا اثنان يفترقان
# عند التدوير.
# وبلا ضبطه تردّ نقاط /api/site الحالة ٥٠٣، فنموذج النشرة في الموقع لا يعمل.
SITE_API_TOKEN=""

# خطّاف الدفع الفوري — الاتجاه المعاكس: النشرة تُرسَل فتظهر في «مقالات»
# الموقع في ثوانٍ بدل انتظار سحبه كلّ ثلاثين دقيقة. وسرُّه مستقلٌّ عن الرمز
# أعلاه عمداً: لو اتّحدا لفتح تسريبُ أحدهما البابين.
# والدفع تحسينٌ لا ركن — بلا ضبطه يلتقط السحبُ الدوري ما فات.
SITE_WEBHOOK_URL=""
SITE_WEBHOOK_SECRET=""
